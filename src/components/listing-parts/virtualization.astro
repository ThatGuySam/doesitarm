---
// Subdued Parallels links for listings that are not native.
// The service card (src/components/service-card.astro) takes the main slot.
const {
  listing
} = Astro.props

const isNonNative = listing.status !== 'native'

const links = [
    {
        label: 'Parallels compatibility',
        href: 'https://prf.hn/l/pRelBQ5'
    },
    {
        label: 'Parallels performance',
        href: 'https://prf.hn/l/J9G0JeM'
    }
]
---
{ isNonNative && (
    <p class="virtualization-links text-xs text-gray-400" data-testid="virtualization-links">
        <span>Run Windows apps instead: </span>
        { links.map( ( link, i ) => (
            <>
                { i !== 0 && <span aria-hidden="true"> · </span> }
                <a
                    href={ link.href }
                    rel="sponsored noopener"
                    class="underline hover:text-white"
                >{ link.label }</a>
            </>
        ) ) }
    </p>
)}
