---
import Heading from './heading.astro'
import { getDeviceAmazonUrl, getListedDeviceListings } from '~/helpers/device-catalog.js'
import { deviceSupportsApp } from '~/helpers/devices.js'

const {
  listing
} = Astro.props

const deviceSupport = getListedDeviceListings().map( device => {
    const supportsApp = deviceSupportsApp( device, listing )

    return {
        ...device,
        label: `${ supportsApp ? '✅' : '🚫' } ${ device.name }`,
        amazonUrl: getDeviceAmazonUrl( device ),
        ariaLabel: `${ listing.name } has ${ supportsApp ? '' : 'not ' }been reported to work on ${ device.name }`
    }
} )

const hasDeviceSupport = deviceSupport.length > 0
---
{ hasDeviceSupport && (
    <div class="device-support w-full">

        <Heading text='💻 Device Support' />

        <div class="device-support-apps md:inline-flex md:w-full max-w-4xl overflow-x-auto overflow-y-visible md:whitespace-no-wrap border rounded-lg divide-y md:divide-y-0 md:divide-x divide-gray-700 space-y-3 md:space-y-0 py-4 px-3">

            { deviceSupport.map( device => (
                <div class="device-container w-full md:w-auto inline-flex flex-col space-y-2 px-2">
                    <a
                        href={ device.endpoint }
                        role="button"
                        class="device-link block rounded-md text-sm font-medium leading-5 focus:outline-none focus:text-white focus:bg-gray-700 transition duration-150 ease-in-out text-gray-300 hover:bg-darker hover:neumorphic-shadow p-2"
                        aria-label={ device.ariaLabel }
                    >{ device.label }</a>

                    <span class="device-shop-links flex flex-wrap justify-center gap-x-3 gap-y-1 text-xs pb-3">
                        <a href={ device.amazonUrl } target="_blank" class="underline whitespace-nowrap" rel="sponsored nofollow noopener" data-device-amazon>Check Pricing</a>
                        <a href={ device.productUrl } target="_blank" class="underline whitespace-nowrap text-gray-400" rel="noopener">Apple specs</a>
                    </span>
                </div>
            )) }

        </div>

        <p class="text-xs text-gray-500 mt-2">As an Amazon Associate, Does It ARM earns from qualifying purchases.</p>

    </div>
)}
