---
import Heading from './heading.astro'
import { getDeviceAmazonUrl, getListedDeviceListings } from '~/helpers/device-catalog.js'
import { deviceSupportsApp } from '~/helpers/devices.js'

const {
  listing
} = Astro.props

const deviceSupport = getListedDeviceListings().map( device => {
    const supportsApp = deviceSupportsApp( device, listing )

    return {
        ...device,
        label: `${ supportsApp ? '✅' : '🚫' } ${ device.name }`,
        amazonUrl: getDeviceAmazonUrl( device ),
        ariaLabel: `${ listing.name } has ${ supportsApp ? '' : 'not ' }been reported to work on ${ device.name }`
    }
} )

const hasDeviceSupport = deviceSupport.length > 0
---
{ hasDeviceSupport && (
    <div class="device-support w-full">

        <Heading text='💻 Device Support' />

        <ul class="device-support-apps mx-auto grid max-w-[56rem] grid-cols-1 gap-x-6 text-left md:grid-cols-[repeat(auto-fill,minmax(min(100%,14rem),1fr))]" role="list">

            { deviceSupport.map( device => (
                <li class="flex items-baseline justify-between gap-3 border-b border-white/[0.06] py-2 text-sm">
                    <a
                        href={ device.endpoint }
                        class="device-link min-w-0 [overflow-wrap:anywhere] hover:underline focus-visible:underline"
                        aria-label={ device.ariaLabel }
                    >{ device.label }</a>

                    <span class="device-shop-links shrink-0 text-right text-xs text-gray-400">
                        <a href={ device.amazonUrl } target="_blank" class="whitespace-nowrap underline hover:text-white" rel="sponsored nofollow noopener" aria-label={ `Check Pricing for ${ device.name } on Amazon` } data-device-amazon>Check Pricing</a>
                        <span aria-hidden="true"> · </span>
                        <a href={ device.productUrl } target="_blank" class="whitespace-nowrap underline hover:text-white" rel="noopener" aria-label={ `Apple Specs for ${ device.name }` }>Specs</a>
                    </span>
                </li>
            )) }

        </ul>

        <p class="text-xs text-gray-500 mt-2">As an Amazon Associate, Does It ARM earns from qualifying purchases.</p>

    </div>
)}
