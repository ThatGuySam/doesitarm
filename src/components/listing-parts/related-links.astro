---
const {
  listing
} = Astro.props

const hasRelatedLinks = Array.isArray( listing.relatedLinks ) && listing.relatedLinks.length > 0
---
{ hasRelatedLinks && (
    <div class="links flex flex-wrap justify-center gap-2">
        { listing.relatedLinks.map( ( link, i ) => (
            <a
                class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium leading-tight text-gray-200 border border-white/10 bg-white/5 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-400"
                href={ link.href }
                target="_blank"
                rel="noopener"
            >{ i === 0 && !link.label.includes( '🧪' ) ? 'View' : link.label }</a>
        ) ) }
    </div>
) }
