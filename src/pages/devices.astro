---
// Component Script:
// You can write any JavaScript/TypeScript that you'd like here.
// It will run during the build, but never in the browser.
// All variables are available to use in the HTML template below.

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/

import {
    deviceCatalog,
    getListedDeviceListings
} from '~/helpers/device-catalog.js'
import {
    applyResponseDefaults
} from '~/helpers/astro/request.js'

import Layout from '../layouts/default.astro'

applyResponseDefaults( Astro )

const devices = getListedDeviceListings()

---
<Layout
	headOptions={ {
        title: '2026 Apple silicon Macs: M5, M5 Pro, M5 Max, and A18 Pro',
        description: 'Compare the 2026 MacBook Neo, M5 MacBook Air, and M5 Pro or M5 Max MacBook Pro models, then check reported app compatibility.',
        pathname: '/devices/',
    } }
>

    <main class="container py-24">
        <div class="flex flex-col space-y-8">
            <div class="max-w-4xl space-y-4">
                <p class="text-sm font-bold uppercase tracking-wide text-green-300">
                    Reviewed { deviceCatalog.lastReviewed }
                </p>
                <h1 class="title text-3xl md:text-5xl leading-tight">
                    2026 Macs with Apple silicon
                </h1>
                <p class="text-lg leading-8">
                    { deviceCatalog.scope.description }
                </p>
                <p class="text-sm leading-6 text-gray-400">
                    { deviceCatalog.scope.exclusionNote }
                </p>
            </div>

            <div class="line-separator border-white border-t-2" />

            <div class="grid gap-6 lg:grid-cols-2">
                { devices.map( device => (
                    <article class="rounded-lg border border-gray-700 bg-gradient-to-br from-darker to-dark p-6 space-y-5">
                        <div class="space-y-2">
                            <p class="text-sm font-bold text-green-300">
                                { device.chips.join(' or ') }
                            </p>
                            <h2 class="text-2xl md:text-3xl font-hairline">
                                <a class="hover:underline" href={ device.endpoint }>
                                    { device.shortName }
                                </a>
                            </h2>
                        </div>

                        <p class="text-sm leading-6 text-gray-300">
                            { device.description }
                        </p>

                        <dl class="grid grid-cols-2 gap-4 text-sm">
                            { device.facts.slice(0, 4).map( fact => (
                                <div class="space-y-1">
                                    <dt class="font-bold text-gray-400">{ fact.label }</dt>
                                    <dd>{ fact.value }</dd>
                                </div>
                            )) }
                        </dl>

                        <a
                            class="inline-flex rounded-md border border-gray-500 px-4 py-2 font-bold hover:bg-darkest focus:outline-none focus:ring"
                            href={ device.endpoint }
                        >
                            Check apps and full specifications →
                        </a>
                    </article>
                )) }
            </div>

            <aside class="max-w-4xl rounded-lg border border-gray-700 p-6 space-y-3">
                <h2 class="text-xl font-bold">
                    Why the pages are separate
                </h2>
                <p class="text-sm leading-6">
                    App architecture support is shared across Apple silicon Macs, but the hardware limits are not. Each page pairs the same reported native or Rosetta status with that model’s real chip, memory, storage, display, port, and external-display options so you can tell a software compatibility result from a configuration constraint.
                </p>
                <p class="text-sm leading-6 text-gray-400">
                    Every model fact links back to Apple’s announcement, technical specifications, or model-identification documentation.
                </p>
                <p class="text-sm leading-6 text-gray-400">
                    Native means the reported app includes Apple silicon code. Rosetta means the report relies on Apple’s translation layer for an Intel build. Apple says Rosetta remains available through macOS 27, so a current Native or Universal app is the safer long-term choice.
                    {' '}
                    <a class="underline" href="https://support.apple.com/en-us/102527" target="_blank" rel="noopener">
                        Read Apple’s Rosetta guidance ↗
                    </a>
                </p>
            </aside>

        </div>
    </main>

	<!--

	You can also use imported framework components directly in your markup!

	Note: by default, these components are NOT interactive on the client.
	The `:visible` directive tells Astro to make it interactive.

	See https://docs.astro.build/core-concepts/component-hydration/

	-->

</Layout>
