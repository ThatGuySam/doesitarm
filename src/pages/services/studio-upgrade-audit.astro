---
// Logic upgrade audit. Copy lives in helpers/service-offers.js (auditPage).
import { applyResponseDefaults } from '~/helpers/astro/request.js'
import { auditPage as page, serviceRequestsEndpoint } from '~/helpers/service-offers.js'

import Layout from '~/src/layouts/default.astro'
import '~/assets/css/service-page.css'

applyResponseDefaults( Astro )
---
<Layout
    headOptions={ {
        title: `${ page.title } for Apple Silicon Macs - Does It ARM`,
        description: page.subhead,
        pathname: '/services/studio-upgrade-audit/'
    } }
>
    <main class="svc-page container py-32 w-full" data-svc-card="service-page" data-svc-page data-svc-variant="direct">
        <div class="max-w-3xl mx-auto space-y-16">

            <section class="space-y-6 text-center">
                <h1 class="title text-3xl md:text-5xl font-hairline leading-tight">{ page.headline }</h1>
                <p class="subtitle md:text-xl text-gray-300">{ page.subhead }</p>
                <p class="text-white font-semibold">{ page.price }</p>
                <div class="flex flex-wrap justify-center items-center gap-4">
                    <a href="#scope" class="svc-page-button" data-svc-control="primary">{ page.primary }</a>
                    <a href="#waitlist" class="text-indigo-200 underline hover:text-white" data-svc-control="secondary">{ page.secondary }</a>
                </div>
            </section>

            <!-- Media slot: set auditPage.media.src in helpers/service-offers.js to show a screenshot or video -->
            <section class="svc-media" data-service-media>
                { page.media.src && page.media.type === 'video' && (
                    <video src={ page.media.src } controls playsinline preload="metadata" class="w-full h-full rounded-xl" />
                ) }
                { page.media.src && page.media.type !== 'video' && (
                    <img src={ page.media.src } alt={ page.media.label } class="w-full h-full object-cover rounded-xl" />
                ) }
                { !page.media.src && (
                    <div class="svc-media-placeholder">
                        <span class="text-sm text-gray-400">{ page.media.label }</span>
                    </div>
                ) }
            </section>

            <section class="grid gap-4 md:grid-cols-3">
                { page.points.map( point => (
                    <div class="rounded-xl border border-gray-700 bg-gradient-to-br from-darker to-dark p-5 space-y-2">
                        <h2 class="font-bold text-white">{ point.title }</h2>
                        <p class="text-sm text-gray-300 leading-relaxed">{ point.text }</p>
                    </div>
                ) ) }
            </section>

            <section id="scope" class="svc-panel space-y-4">
                <div class="space-y-1">
                    <h2 class="text-2xl font-bold text-white">{ page.scope.heading }</h2>
                    <p class="text-sm text-gray-300">{ page.scope.intro }</p>
                </div>
                <form
                    class="grid gap-4 sm:grid-cols-2"
                    action={ serviceRequestsEndpoint }
                    method="post"
                    data-svc-form
                    data-svc-submit="scope"
                    data-svc-success={ page.scope.success }
                >
                    <input type="hidden" name="offer" value="studio-upgrade-audit" />
                    <input type="hidden" name="kind" value="scope" />
                    <input type="text" name="website" autocomplete="off" hidden tabindex="-1" />
                    <label class="svc-field sm:col-span-2">
                        <span>Email</span>
                        <input type="email" name="email" autocomplete="email" maxlength="254" required />
                    </label>
                    <label class="svc-field">
                        <span>When are you moving?</span>
                        <input type="text" name="moveDate" maxlength="40" placeholder="e.g. January, or not sure" />
                    </label>
                    <label class="svc-field">
                        <span>DAW and version</span>
                        <input type="text" name="daw" maxlength="80" value="Logic Pro " />
                    </label>
                    <label class="svc-field sm:col-span-2">
                        <span>One plug-in you can’t lose</span>
                        <input type="text" name="plugin" maxlength="120" placeholder="e.g. Omnisphere 2.8" />
                    </label>
                    <div class="sm:col-span-2 svc-turnstile" data-svc-turnstile></div>
                    <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
                        <button type="submit" class="svc-page-button">{ page.scope.submit }</button>
                        <p class="text-sm text-gray-300" role="status" data-svc-status></p>
                    </div>
                </form>
            </section>

            <section id="waitlist" class="svc-panel space-y-4">
                <div class="space-y-1">
                    <h2 class="text-xl font-bold text-white">{ page.waitlist.heading }</h2>
                    <p class="text-sm text-gray-300">{ page.waitlist.intro }</p>
                </div>
                <form
                    class="flex flex-wrap items-end gap-3"
                    action={ serviceRequestsEndpoint }
                    method="post"
                    data-svc-form
                    data-svc-submit="waitlist"
                    data-svc-success={ page.waitlist.success }
                >
                    <input type="hidden" name="offer" value="studio-upgrade-audit" />
                    <input type="hidden" name="kind" value="waitlist" />
                    <input type="text" name="website" autocomplete="off" hidden tabindex="-1" />
                    <label class="svc-field flex-1" style="min-width: 14rem;">
                        <span>Email</span>
                        <input type="email" name="email" autocomplete="email" maxlength="254" required />
                    </label>
                    <div class="w-full svc-turnstile" data-svc-turnstile></div>
                    <button type="submit" class="svc-page-button svc-page-button-quiet">{ page.waitlist.submit }</button>
                    <p class="w-full text-sm text-gray-300" role="status" data-svc-status></p>
                </form>
            </section>

            <section class="space-y-6">
                { page.faq.map( item => (
                    <div class="space-y-1">
                        <h2 class="font-bold text-white">{ item.question }</h2>
                        <p class="text-sm text-gray-300 leading-relaxed">{ item.answer }</p>
                    </div>
                ) ) }
            </section>

        </div>
    </main>
</Layout>

<script>
    import { serviceEventsEndpoint, turnstileSiteKey } from '~/helpers/service-offers.js'
    import { initServicePage } from '~/helpers/service-cards-browser.js'

    initServicePage( { eventsEndpoint: serviceEventsEndpoint, turnstileSiteKey } )
</script>
