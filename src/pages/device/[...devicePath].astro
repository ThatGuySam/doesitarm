---
// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/


import { getPathPartsFromAstroRequest } from '~/helpers/url.js'
import {
    catchRedirectResponse,
    applyResponseDefaults
} from '~/helpers/astro/request.js'
import { getDeviceListingBySlug } from '~/helpers/site-listings.js'


import Layout from '../../layouts/default.astro'
import Search from '~/components/search-stork.vue'
import CarbonInline from '~/components/carbon-inline.vue'
import LinkButton from '~/components/link-button.vue'


// Get type and slug from the request path
// so that we don't have extra parts for
// urls like /:type/:slug/benchmarks
const {
    pathSlug,
    subSlug = 1
 } = getPathPartsFromAstroRequest( Astro.request )


const redirectResponse = await catchRedirectResponse( Astro )

if ( redirectResponse !== null ) {
  return redirectResponse
}

applyResponseDefaults( Astro )

const device = getDeviceListingBySlug( pathSlug )

if ( device === null || typeof device === 'undefined' ) {
    return Astro.redirect( '/devices/', 301 )
}

if ( String( subSlug ) !== '1' ) {
    return Astro.redirect( device.endpoint, 301 )
}

const appPage = {
    items: [],
    summary: null,
    previousPage: '',
    nextPage: ''
}

---
<Layout
    headOptions={{
        title: device.seoTitle,
        description: device.seoDescription,
        pathname: device.endpoint
    }}
>

     <main class="container py-24">
        <div class="flex flex-col items-center space-y-10">

            <header class="hero max-w-5xl space-y-5 text-center">
                <p class="text-sm font-bold uppercase tracking-wide text-green-300">
                    Introduced { device.releaseYear } · { device.chips.join(' or ') }
                </p>
                <h1 class="title text-3xl md:text-5xl font-hairline leading-tight">
                    App compatibility for { device.shortName }
                </h1>

                <p class="subtitle md:text-xl leading-8">
                    { device.description }
                </p>
            </header>

            <section class="w-full max-w-5xl grid gap-6 lg:grid-cols-2">
                <div class="rounded-lg border border-gray-700 p-6 space-y-4">
                    <h2 class="text-2xl font-bold">
                        What this model changes
                    </h2>
                    { device.intro.map( paragraph => (
                        <p class="text-sm leading-7">{ paragraph }</p>
                    )) }
                </div>

                <div class="rounded-lg border border-gray-700 p-6 space-y-4">
                    <h2 class="text-2xl font-bold">
                        { device.comparison.heading }
                    </h2>
                    <p class="text-sm leading-7">
                        { device.comparison.body }
                    </p>
                    <a class="inline-flex font-bold underline" href={ device.comparison.href }>
                        Open the comparison model →
                    </a>
                </div>
            </section>

            <section class="w-full max-w-5xl space-y-5">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <p class="text-sm font-bold uppercase tracking-wide text-gray-400">
                            Apple specifications
                        </p>
                        <h2 class="text-2xl md:text-3xl font-bold">
                            2026 model at a glance
                        </h2>
                    </div>
                    <LinkButton
                        href={ device.productUrl }
                        target="_blank"
                        label="View Apple technical specs ↗"
                    />
                </div>

                <dl class="grid gap-px overflow-hidden rounded-lg border border-gray-700 bg-gray-700 sm:grid-cols-2 lg:grid-cols-3">
                    { device.facts.map( fact => (
                        <div class="bg-darker p-5 space-y-2">
                            <dt class="text-xs font-bold uppercase tracking-wide text-gray-400">
                                { fact.label }
                            </dt>
                            <dd class="text-sm leading-6">
                                { fact.value }
                            </dd>
                        </div>
                    )) }
                </dl>
            </section>

            <section class="w-full max-w-5xl rounded-lg border border-green-800 bg-gradient-to-br from-darker to-dark p-6 space-y-5">
                <div class="space-y-3">
                    <p class="text-sm font-bold uppercase tracking-wide text-green-300">
                        Model-specific decision guide
                    </p>
                    <h2 class="text-2xl md:text-3xl font-bold">
                        { device.decisionGuide.heading }
                    </h2>
                    <p class="text-sm leading-7">
                        { device.decisionGuide.summary }
                    </p>
                </div>
                <ul class="list-disc pl-6 space-y-3 text-sm leading-7">
                    { device.decisionGuide.points.map( point => (
                        <li>{ point }</li>
                    )) }
                </ul>
            </section>

            <section class="w-full max-w-5xl space-y-4">
                <h2 class="text-2xl md:text-3xl font-bold">
                    Official sources for { device.shortName }
                </h2>
                <ul class="list-disc pl-6 space-y-2 text-sm">
                    { device.officialSources.map( source => (
                        <li>
                            <a class="underline" href={ source.url } target="_blank" rel="noopener">
                                { source.label } ↗
                            </a>
                        </li>
                    )) }
                </ul>
            </section>

            <section class="w-full space-y-5" aria-labelledby="compatible-apps-heading">
                <div class="max-w-5xl mx-auto text-center space-y-3">
                    <h2 id="compatible-apps-heading" class="text-2xl md:text-3xl font-bold">
                        Search reported apps for { device.shortName }
                    </h2>
                    <p class="text-sm text-gray-400">
                        Search by app name or filter the database by Native, Rosetta, in-progress, unsupported, or unreported status. Results describe app architecture support; confirm plug-ins, drivers, memory needs, and the developer’s current macOS requirements separately.
                    </p>
                </div>

                <Search
                    kind-page={ appPage }
                    base-filters={ [ 'type_app' ] }
                    initial-limit={ 0 }
                    client:load
                >
                    <CarbonInline
                        class="carbon-inline-wide"
                    />
                </Search>
            </section>

        </div>
    </main>

</Layout>
