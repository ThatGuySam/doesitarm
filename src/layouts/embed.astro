---
import '~/assets/css/tailwind.css'

import { PageHead } from '~/helpers/config-node.js'

import CookieConsent from '~/src/components/cookie-consent.astro'

const {
    // headTitle,
    // headDescription,
    headOptions = {}
} = Astro.props

// console.log('Astro.site', Astro.site )

const pageHead = new PageHead({
    domain: Astro.site.origin,

    ...headOptions
})

---
<!doctype html>
<html lang="en">
    <head>
        <title>{ pageHead.title }</title>
        <Fragment set:html={ pageHead.allHeadMarkup } />

    </head>
    <body>
        <slot />
        <CookieConsent />
        <footer class="fixed bottom-0 right-0 z-10">
            <button type="button" class="px-2 py-1 text-xs text-white bg-black underline" data-cookie-settings aria-controls="cookie-consent" hidden>Cookie settings</button>
        </footer>
    </body>
</html>


