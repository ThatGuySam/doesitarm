{
  // Public, read-only remote MCP server for doesitarm.com.
  // Stateless Streamable HTTP at https://mcp.doesitarm.com/mcp. Reads the
  // public API only; no bindings to the site's KV, D1 or other Workers.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "doesitarm-mcp",
  "main": "src/index.js",
  "account_id": "8d4ef8fe891f53e5658d3fdd5a4c7630",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_API_DOMAIN": "https://api.doesitarm.com"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "3510340",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "mcp.doesitarm.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
