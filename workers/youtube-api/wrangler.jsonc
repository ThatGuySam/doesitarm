{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "doesitarm-youtube-api",
  "main": "src/entry.py",
  "account_id": "8d4ef8fe891f53e5658d3fdd5a4c7630",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["python_workers"],
  // workers.dev only: no routes or custom domains.
  "workers_dev": true,
  "preview_urls": false,
  // Paid plan: extraction is CPU-heavy Python. Network waits do not count.
  "limits": { "cpu_ms": 120000 },
  "observability": { "enabled": true },
  "vars": {
    // From hosted canaries on 2026-11-27: Watch pages from Cloudflare egress are often
    // redirected to google.com/sorry and the default visionos Player returns
    // LOGIN_REQUIRED; tv_simply then web_embedded returned full metadata 5/5.
    "PLAYER_CLIENT": "tv_simply,web_embedded"
  },
  // Daily qualify-and-promote job (UTC).
  "triggers": { "crons": ["*/3 * * * *"] },
  "kv_namespaces": [
    { "binding": "YT_STATE", "id": "cf44dc02a5e4472bb95fec0f0cf10080" }
  ],
  "r2_buckets": [
    { "binding": "WHEELS", "bucket_name": "doesitarm-youtube-wheels" }
  ],
  // The daily job calls its own /internal/canary so each yt-dlp version runs in
  // its own invocation with its own CPU and subrequest budget.
  "services": [
    { "binding": "SELF", "service": "doesitarm-youtube-api" }
  ]
  // Secret (not in this file): CANARY_KEY, set with `wrangler secret put CANARY_KEY`.
}
