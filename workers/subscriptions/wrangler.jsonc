{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "doesitarm-subscriptions",
  "main": "src/index.js",
  "account_id": "8d4ef8fe891f53e5658d3fdd5a4c7630",
  "compatibility_date": "2026-07-25",
  "keep_vars": true,
  "triggers": {
    "crons": ["0 14 * * *"]
  },
  "ratelimits": [
    {
      "name": "INTEREST_IP_RATE_LIMIT",
      "namespace_id": "3510321",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "INTEREST_EMAIL_RATE_LIMIT",
      "namespace_id": "3510322",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "SERVICE_EVENT_RATE_LIMIT",
      "namespace_id": "3510323",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "SUBSCRIPTIONS_DB",
      "database_name": "doesitarm-subscriptions",
      "database_id": "7d545f65-4cbd-405c-aafb-75b18a57fcc9",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "doesitarm.com/api/subscriptions*",
      "zone_name": "doesitarm.com"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
